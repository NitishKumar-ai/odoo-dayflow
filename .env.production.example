# Dayflow Production Environment Configuration Template
# Copy or set these environment variables in your hosting provider (e.g., Vercel, Render)

# Node Environment
NODE_ENV=production

# Application URL
# Public canonical URL of your hosted Dayflow instance (e.g., https://dayflow.yourdomain.com)
APP_URL=https://your-dayflow-domain.vercel.app

# Database Connection URL (Managed PostgreSQL)
# Must connect to a managed PostgreSQL instance (e.g., Supabase, Neon, AWS RDS, Render Postgres)
# Requirements:
# 1. Must enforce SSL in production (e.g., ?sslmode=require)
# 2. Recommended to use pooled connection strings for serverless deployments
# Example: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://user:password@host.managed-db.provider.com:5432/dayflow_prod?sslmode=require

# Session Secret Key
# Required for signing auth session cookies and tokens.
# MUST NOT use development secrets or defaults.
# Generate a strong 32-byte secret using: openssl rand -hex 32
SESSION_SECRET=e.g._generate_a_64_character_hex_string_using_openssl_rand_hex_32

# Mail Provider Configuration (Optional / Production Auth)
# Required for sending email verification tokens to newly registered users
# RESEND_API_KEY=re_123456789...
# MAIL_FROM=noreply@yourdomain.com

# Initial Super-Admin Provisioning Variables (Used only during npm run db:create-admin)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=StrongSuperAdminPassword123!
# ADMIN_CODE=ADM001
# ADMIN_FIRST_NAME=System
# ADMIN_LAST_NAME=Administrator
